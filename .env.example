# Required: your Jev API key. Server-side only -- it is never sent to the
# browser and never appears in any API response or log line.
JEV_API_KEY=

# Optional: the Jev model that scores new answers.
JEV_MODEL=typesafe/jev-1.13

# Optional: Jev API base URL. The client appends /v1/systemone.
# Override only to point at a mock or a staging host.
JEV_API_BASE_URL=https://thejevai.com

# Optional: where the SQLite database lives.
DATABASE_FILE=data/daily.db

# Optional: HTTP port.
PORT=3000
