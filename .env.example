# Which judge scores new answers.
#   local  (default) -- a jev-local server on this machine. No API key, no
#                        credits, no internet request. start-game.cmd starts
#                        it for you. NOT the same model as hosted Jev.
#   jev              -- the hosted Jev API. Needs JEV_API_KEY and spends credits.
JUDGE_PROVIDER=local

# --- local provider ------------------------------------------------------
# JEVLOCAL_BASE_URL=http://127.0.0.1:8000
# JEVLOCAL_HOME=%USERPROFILE%\Programs\jev-local
# JEVLOCAL_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# JEVLOCAL_TIMEOUT_MS=300000

# --- hosted provider (only read when JUDGE_PROVIDER=jev) -----------------
# Server-side only. Never sent to the browser or logged.
JEV_API_KEY=
# JEV_MODEL=typesafe/jev-1.13
# JEV_API_BASE_URL=https://thejevai.com

# --- optional ------------------------------------------------------------
# DATABASE_FILE=data/daily.db
# PORT=3000
